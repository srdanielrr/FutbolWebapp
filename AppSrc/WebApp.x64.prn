38204>>>>>>>        tWebNavigateData NavigateData
38204>>>>>>>        tWebNavigateData NavigateData
38204>>>>>>>        Boolean bHasRecord
38204>>>>>>>        Handle hoDD
38204>>>>>>>
38204>>>>>>>        Get Server to hoDD
38205>>>>>>>        Get GetNavigateData to NavigateData
38206>>>>>>>        Get HasRecord of hoDD to bHasRecord
38207>>>>>>>
38207>>>>>>>        // let's hide all buttons and then Show the ones we want
38207>>>>>>>        WebSet pbRender of oEditBtn to False
38208>>>>>>>        WebSet pbRender of oSaveBtn to False
38209>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38210>>>>>>>        WebSet pbRender of oDeleteBtn to False
38211>>>>>>>
38211>>>>>>>        If (NavigateData.bReadOnly) Begin
38213>>>>>>>            WebSet pbRender of oEditBtn to True
38214>>>>>>>        End
38214>>>>>>>>
38214>>>>>>>        Else Begin
38215>>>>>>>            WebSet pbRender of oSaveBtn to True
38216>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38217>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38218>>>>>>>        End
38218>>>>>>>>
38218>>>>>>>    End_Procedure
