37481>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37482>>>>>>>        WebSet pbRender of oDeleteBtn to False
37483>>>>>>>
37483>>>>>>>        If (NavigateData.bReadOnly) Begin
37485>>>>>>>            WebSet pbRender of oEditBtn to True
37486>>>>>>>        End
