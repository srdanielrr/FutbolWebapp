37566>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37569>>>>>>>        Case Begin
37569>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37571>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37571>>>>>>>                Case Break
37572>>>>>>>
37572>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37575>>>>>>>                // If from parent, this is a constrained drill down.
37575>>>>>>>                Case Break
37576>>>>>>>
37576>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37579>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37579>>>>>>>                Case Break
37580>>>>>>>
37580>>>>>>>            Case Else // must be nfUndefined
37580>>>>>>>
37580>>>>>>>        Case End
37580>>>>>>>
37580>>>>>>>        Send SetActionButtons
37581>>>>>>>
37581>>>>>>>    End_Procedure
