38843>>>>>>>        WebSet pbRender of oSaveBtn to False
38844>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38845>>>>>>>        WebSet pbRender of oDeleteBtn to False
38846>>>>>>>
38846>>>>>>>        If (NavigateData.bReadOnly) Begin
38848>>>>>>>            WebSet pbRender of oEditBtn to True
38849>>>>>>>        End
38849>>>>>>>>
38849>>>>>>>        Else Begin
38850>>>>>>>            WebSet pbRender of oSaveBtn to True
38851>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38852>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38853>>>>>>>        End
38853>>>>>>>>
38853>>>>>>>    End_Procedure
