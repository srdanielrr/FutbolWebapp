38859>>>>>>>        WebSet pbRender of oEditBtn to False
38860>>>>>>>        WebSet pbRender of oSaveBtn to False
38861>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38862>>>>>>>        WebSet pbRender of oDeleteBtn to False
38863>>>>>>>
38863>>>>>>>        If (NavigateData.bReadOnly) Begin
38865>>>>>>>            WebSet pbRender of oEditBtn to True
38866>>>>>>>        End
38866>>>>>>>>
38866>>>>>>>        Else Begin
38867>>>>>>>            WebSet pbRender of oSaveBtn to True
38868>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38869>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38870>>>>>>>        End
38870>>>>>>>>
38870>>>>>>>    End_Procedure
