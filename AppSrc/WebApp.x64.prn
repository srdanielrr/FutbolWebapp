37538>>>>>>>    Procedure SetActionButtons
37541>>>>>>>        tWebNavigateData NavigateData
37541>>>>>>>        tWebNavigateData NavigateData
37541>>>>>>>        Boolean bHasRecord
37541>>>>>>>        Handle hoDD
37541>>>>>>>
37541>>>>>>>        Get Server to hoDD
37542>>>>>>>        Get GetNavigateData to NavigateData
37543>>>>>>>        Get HasRecord of hoDD to bHasRecord
37544>>>>>>>
37544>>>>>>>        // let's hide all buttons and then Show the ones we want
37544>>>>>>>        WebSet pbRender of oEditBtn to False
37545>>>>>>>        WebSet pbRender of oSaveBtn to False
37546>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37547>>>>>>>        WebSet pbRender of oDeleteBtn to False
37548>>>>>>>
37548>>>>>>>        If (NavigateData.bReadOnly) Begin
37550>>>>>>>            WebSet pbRender of oEditBtn to True
37551>>>>>>>        End
37551>>>>>>>>
37551>>>>>>>        Else Begin
37552>>>>>>>            WebSet pbRender of oSaveBtn to True
37553>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37554>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37555>>>>>>>        End
37555>>>>>>>>
37555>>>>>>>    End_Procedure
