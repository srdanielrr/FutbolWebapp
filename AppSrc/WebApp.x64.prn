37486>>>>>>>        Else Begin
37487>>>>>>>            WebSet pbRender of oSaveBtn to True
37488>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37489>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37490>>>>>>>        End
